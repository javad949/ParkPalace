  <ItemGroup>
    <ProjectReference Include="..\ParkPalace.Infrastructure\ParkPalace.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
